# ============================================================
# Machine Learning Journey — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ============================================================

# === Project ===
PROJECT_NAME=machine-learning-journey
ENVIRONMENT=development
DEBUG=true

# === Paths ===
DATA_DIR=./datasets
MODEL_DIR=./checkpoints
LOG_DIR=./logs

# === API Keys (fill in your own) ===
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
WANDB_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=default

# === Database (optional) ===
DATABASE_URL=sqlite:///./data.db

# === Docker ===
JUPYTER_PORT=8888
API_PORT=8000
